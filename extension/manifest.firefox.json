{
  "manifest_version": 3,
  "name": "NetMerge Downloads",
  "version": "1.0.0",
  "description": "Sends big downloads to NetMerge, which downloads them over all your internet connections at once.",
  "browser_specific_settings": { "gecko": { "id": "downloads@netmerge.app", "strict_min_version": "115.0" } },
  "permissions": ["downloads", "storage", "contextMenus", "alarms", "cookies", "webRequest"],
  "host_permissions": ["http://127.0.0.1:9196/*"],
  "optional_permissions": [],
  "background": { "scripts": ["core.js", "background.js"] },
  "action": { "default_title": "NetMerge Downloads", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
