rules_version = '2';
// NetMerge for Windows diagnostics (Firebase project netmerge-windows). Reports may only be added, with these
// fields and sizes; nothing can be read, changed or deleted from the app. Published in Firestore > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(
            ['install', 'kind', 'app', 'os', 'device', 'settings', 'engine', 'log', 'crash', 'at'])
        && request.resource.data.keys().hasAll(['install', 'kind', 'app', 'log', 'at'])
        && request.resource.data.install is string && request.resource.data.install.size() <= 64
        && request.resource.data.kind in ['log', 'crash']
        && request.resource.data.app is string && request.resource.data.app.size() <= 40
        && request.resource.data.log is string && request.resource.data.log.size() <= 110000
        && request.resource.data.at is timestamp
        && (!('os' in request.resource.data) || request.resource.data.os.size() <= 200)
        && (!('device' in request.resource.data) || request.resource.data.device.size() <= 300)
        && (!('settings' in request.resource.data) || request.resource.data.settings.size() <= 4000)
        && (!('engine' in request.resource.data) || request.resource.data.engine.size() <= 8000)
        && (!('crash' in request.resource.data) || request.resource.data.crash.size() <= 50000);
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
